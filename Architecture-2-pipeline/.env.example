# Clé API obtenue sur https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=coller_votre_cle_ici

# Modèle Google AI Studio à utiliser (Gemma OU Gemini, le client est
# identique pour les deux via le SDK `google-genai`).
#
# Défaut : gemini-2.5-flash, un modèle du tier GRATUIT (aucune carte
# bancaire requise). Depuis avril 2026, les modèles "Pro" (gemini-2.5-pro,
# gemini-3.x-pro...) sont passés payants sur AI Studio : seuls les modèles
# "Flash" et "Flash-Lite" restent gratuits, avec un débit limité (voir
# https://aistudio.google.com/ pour les quotas exacts de votre compte).
# Alternative plus légère/rapide : gemini-2.5-flash-lite.
LLM_MODEL=gemini-3.6-flash

# Nombre max de tentatives de réparation internes à l'Agent 1 (self-check)
AGENT1_MAX_REPAIR_ATTEMPTS=2

# Température des appels LLM (0 = déterministe, conseillé pour du YAML)
LLM_TEMPERATURE=0.2

# Plafond de tokens en sortie. Les réponses JSON contenant du YAML complet
# (Agent 4/5) peuvent être longues : une valeur trop basse tronque la
# réponse avant la fin du JSON et casse le parsing. Augmentez si vous
# voyez des erreurs "Extra data" ou du JSON tronqué dans les logs.
LLM_MAX_OUTPUT_TOKENS=8192

# Dossier de sortie des manifestes générés
OUTPUT_DIR=output
