# Clé API obtenue sur https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=coller_votre_cle_ici

# Modèle Gemini à utiliser (voir la liste des modèles disponibles sur AI
# Studio). Aligné par défaut sur Architecture-2-pipeline pour une
# comparaison de benchmark à modèle égal -- vérifiez le nom exact du
# modèle disponible pour votre clé et ajustez si besoin.
# LLM_MODEL est l'alias préféré ; GEMMA_MODEL reste lu par compatibilité
# ascendante si vous l'avez déjà dans un .env existant.
LLM_MODEL=gemini-3.6-flash

# Nombre max de tentatives de réparation internes à l'Agent 1 (self-check
# de l'extraction -- schéma/complétude, avant même la génération du YAML)
AGENT1_MAX_REPAIR_ATTEMPTS=2

# Architecture C uniquement : nombre max d'itérations de la boucle
# Generator <-> Validator (agent2_generator_fix <-> agent3_validation),
# sur des erreurs de schéma/sécurité structurées. Voir
# agents/agent2_template.py::run_generator_fix, agents/agent3_validation.py,
# graph.py::_route_after_agent3.
MAX_ITERATIONS=3

# Architecture C uniquement : nombre max de passages par la boucle de
# réparation post-Agent 5 (agent5 -> repair -> agent5), sur des
# contraintes globales du blackboard. Mécanisme DISTINCT de
# MAX_ITERATIONS ci-dessus (problèmes différents, boucles indépendantes).
# Voir agents/agent_repair.py, graph.py::_route_after_agent5.
MAX_REPAIR_ATTEMPTS=2

# Température des appels LLM (0 = déterministe, conseillé pour du YAML)
LLM_TEMPERATURE=0.2

# Plafond de tokens en sortie. Les réponses JSON contenant du YAML complet
# (Agent 4/5) peuvent être longues : une valeur trop basse tronque la
# réponse avant la fin du JSON et casse le parsing. Augmentez si vous
# voyez des erreurs "Extra data" ou du JSON tronqué dans les logs.
LLM_MAX_OUTPUT_TOKENS=8192

# Dossier de sortie des manifestes générés
OUTPUT_DIR=output
